data/*.pbf
data/*.osm

# Overpass API cache (runtime artifacts, regenerable)
cache/*.json

# Generated demo output (regenerable)
examples/output/*.html
examples/output/*.png

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# IDE
.vscode/
.idea/
.DS_Store
